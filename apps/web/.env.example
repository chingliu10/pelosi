# Copy to .env and fill in real values. Never commit the real .env file.

PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=pelosi
DB_USER=postgres
DB_PASSWORD=replace-me

# Pelosi server -> TrueOdds server (server-side only, never sent to browsers)
TRUEODDS_BASE_URL=https://trueodds.example.com/api/v1
TRUEODDSAPIKEY=replace-me

# Admin browser -> Pelosi server sessions.
# Must be at least 32 characters, for example:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-at-least-32-random-characters
SESSION_COOKIE_NAME=pelosi.sid

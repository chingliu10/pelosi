<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{pageTitle}} · Wachimba Odds Admin</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="topbar">
        <div class="topbar__inner">
            <a class="brand" href="/admin/tips/new">
                <svg class="brand__mark" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
                    <rect x="1.5" y="1.5" width="17" height="17" rx="4" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
                    <path d="M6 12.5l2.6-3.2 2.1 2.1L14.5 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                <span class="brand__name">Wachimba Odds</span>
                <span class="brand__badge">Admin</span>
            </a>

            {{#if nav.length}}
            <nav class="nav" aria-label="Admin sections">
                {{#each nav}}
                    {{#if this.available}}
                        <a class="nav__link{{#if this.active}} is-active{{/if}}" href="{{this.href}}"{{#if this.active}} aria-current="page"{{/if}}>{{this.label}}</a>
                    {{else}}
                        <span class="nav__link is-disabled" aria-disabled="true" title="Coming in a later task">{{this.label}}</span>
                    {{/if}}
                {{/each}}
            </nav>
            {{/if}}

            {{#if user}}
            <div class="account">
                <span class="account__user">
                    <span class="account__email">{{user.email}}</span>
                    <span class="account__role">{{user.role}}</span>
                </span>
                <form class="account__form" method="post" action="/admin/logout">
                    <button class="btn btn--ghost btn--sm" type="submit">Sign out</button>
                </form>
            </div>
            {{/if}}
        </div>
    </header>

    <main class="page" id="main">
        {{{body}}}
    </main>

    {{#each pageScripts}}
    <script src="{{this}}" defer></script>
    {{/each}}
</body>
</html>

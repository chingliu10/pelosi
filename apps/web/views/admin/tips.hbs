<section class="page__header page__header--row">
    <div>
        <h1 class="page__title">Tips</h1>
        <p class="page__subtitle">Review imported predictions and their settlement status.</p>
    </div>
    <div class="page__header-actions">
        <a class="btn btn--ghost" href="/admin/slips/new">Build slip</a>
        <a class="btn btn--primary" href="/admin/tips/new">+ Create tip</a>
    </div>
</section>

<noscript>
    <p class="alert alert--pending">This screen needs JavaScript enabled in your browser.</p>
</noscript>

<div class="workspace">
    <div class="workspace__main">
        <section class="card" aria-labelledby="tips-heading">
            <div class="card__header card__header--stack">
                <div class="tips-toolbar">
                    <h2 class="visually-hidden" id="tips-heading">Imported tips</h2>
                    <form class="search search--grow" id="tips-search-form" role="search">
                        <label class="visually-hidden" for="tips-search-input">Search match, team or prediction</label>
                        <input
                            class="input"
                            id="tips-search-input"
                            name="search"
                            type="search"
                            placeholder="Search match, team or prediction..."
                            autocomplete="off"
                            spellcheck="false"
                        >
                        <button class="btn btn--ghost" id="tips-search-button" type="submit">Search</button>
                    </form>
                </div>

                <div class="tabs" id="tips-filters" role="tablist" aria-label="Filter tips by result"></div>
            </div>

            <p class="feedback" id="tips-feedback" role="status" aria-live="polite"></p>

            <div class="empty" id="tips-empty" hidden></div>

            <ul class="tips-list" id="tips-list"></ul>

            <div class="pager" id="tips-pager" hidden>
                <button class="btn btn--ghost btn--sm" id="tips-prev" type="button">Previous</button>
                <span class="pager__status" id="tips-range"></span>
                <button class="btn btn--ghost btn--sm" id="tips-next" type="button">Next</button>
            </div>
        </section>
    </div>

    <aside class="workspace__side" aria-labelledby="tip-detail-heading">
        <section class="card card--sticky">
            <div class="card__header">
                <h2 class="card__title" id="tip-detail-heading">Tip details</h2>
            </div>
            <div id="tip-detail"></div>
        </section>
    </aside>
</div>
